---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
}

const {
  src,
  alt,
  caption,
  width,
  height,
  loading = "lazy",
} = Astro.props;
---

<figure class="my-8">
  <img
    class="w-full h-auto border border-ink-faint rounded-[10px]"
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
  {caption && (
    <figcaption class="mt-2 text-sm leading-snug text-ink-muted text-center">
      {caption}
    </figcaption>
  )}
</figure>
