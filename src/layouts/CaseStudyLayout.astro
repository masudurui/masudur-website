---
import BaseLayout from "./BaseLayout.astro";
import BackLink from "@/components/BackLink.astro";
import TableOfContents from "@/components/TableOfContents.astro";

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  date: string;
  dateFormatted: string;
  ogImage?: string;
  tocTitle?: string;
  tocItems: TocItem[];
  isPasswordProtected?: boolean;
  password?: string;
}

const {
  title,
  description,
  date,
  dateFormatted,
  ogImage,
  tocTitle = "Contents",
  tocItems,
  isPasswordProtected = false,
  password,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <a class="skip-link" href="#main">Skip to content</a>

  {isPasswordProtected && (
    <div class="max-w-content mx-auto px-6 py-20" id="password-gate">
      <div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-8">
        <svg
          class="w-12 h-12 mb-6 text-ink-muted"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <h1 class="text-xl font-semibold mb-2">Protected case study</h1>
        <p class="text-sm text-ink-muted mb-6 max-w-[28rem]">
          This work is under NDA. Enter the password to continue.
        </p>
        <form class="flex gap-2 w-full max-w-[20rem]" id="gate-form">
          <input
            class="flex-1 px-3 py-2 text-sm border border-ink-faint rounded-md outline-none transition-colors duration-150 ease-smooth focus:border-ink"
            id="gate-input"
            type="password"
            placeholder="Password"
            autocomplete="off"
            autofocus
          />
          <button
            class="px-4 py-2 text-sm font-medium text-surface bg-ink border-none rounded-md cursor-pointer transition-opacity duration-150 ease-smooth hover:opacity-80 whitespace-nowrap"
            type="submit"
          >
            Unlock
          </button>
        </form>
        <p class="mt-3 text-sm text-red-600 min-h-5" id="gate-error" aria-live="polite"></p>
      </div>
    </div>
  )}

  <div
    class:list={[
      "cs-container",
      isPasswordProtected && "hidden",
    ]}
    id="case-content"
  >
    <div class="page-layout">
      <aside>
        <BackLink />
        <TableOfContents title={tocTitle} items={tocItems} />
      </aside>

      <main id="main">
        <article class="article">
          <header class="mb-8">
            <h1 class="text-xl font-semibold tracking-tight mb-0.5">{title}</h1>
            <time class="block text-sm text-ink-muted tabular-nums" datetime={date}>
              {dateFormatted}
            </time>
          </header>

          <slot />

          <footer class="mt-12 pt-5 border-t border-ink-faint">
            <slot name="footer" />
            <p class="mb-0">
              <a
                class=""
                href="#"
                data-copy-email="masudurui@gmail.com"
              >
                Get in touch
              </a>.
            </p>
          </footer>
        </article>
      </main>
    </div>
  </div>

  {isPasswordProtected && (
    <script is:inline define:vars={{ password }}>
      (function () {
        var gate = document.getElementById("password-gate");
        var content = document.getElementById("case-content");
        var form = document.getElementById("gate-form");
        var input = document.getElementById("gate-input");
        var error = document.getElementById("gate-error");

        if (sessionStorage.getItem("sh_unlocked") === "1") {
          gate.style.display = "none";
          content.classList.remove("hidden");
        }

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          if (input.value === password) {
            sessionStorage.setItem("sh_unlocked", "1");
            gate.style.display = "none";
            content.classList.remove("hidden");
          } else {
            input.style.borderColor = "#c53030";
            error.textContent = "Incorrect password. Please try again.";
            input.value = "";
            input.focus();
            setTimeout(function () {
              input.style.borderColor = "";
            }, 1500);
          }
        });
      })();
    </script>
  )}
</BaseLayout>

<style>
  /* Case study page shell */
  .cs-container {
    @apply max-w-content mx-auto px-6 pt-20 pb-18;
  }

  .page-layout {
    display: flow-root;
  }

  /* Sidebar for large screens */
  @media (min-width: 68em) {
    .cs-container {
      max-width: none;
    }

    .page-layout {
      display: grid;
      grid-template-columns: 1fr minmax(0, 34rem) 1fr;
      column-gap: 2rem;
      align-items: start;
    }

    .page-layout > aside {
      grid-row: 1 / -1;
      grid-column: 1;
      justify-self: end;
      width: 13rem;
      position: sticky;
      top: 5rem;
      margin-bottom: 0;
    }

    .page-layout > main {
      grid-row: 1;
      grid-column: 2;
    }
  }

  /* Aside styling */
  aside {
    @apply mb-8;
  }

  /* Hide table of contents on tablet and mobile, keep only the back link */
  @media (max-width: 67.99em) {
    aside :global(nav) {
      display: none;
    }
  }

  /* Article prose */
  .article :global(p),
  .article :global(ul) {
    @apply mb-5;
  }

  .article :global(> *:last-child) {
    @apply mb-0;
  }

  .article :global(ul) {
    @apply pl-5;
  }

  .article :global(li) {
    @apply list-disc mb-1;
  }

  .article :global(li::marker) {
    @apply text-ink-muted;
  }

  .article :global(strong) {
    @apply font-semibold;
  }

  .article :global(h3) {
    @apply text-base font-semibold mt-8 mb-2;
  }

  .article :global(blockquote) {
    @apply my-8 pl-5 border-l-2 border-ink-faint;
  }

  .article :global(blockquote p) {
    @apply mb-2;
  }

  .article :global(blockquote cite) {
    @apply text-sm not-italic text-ink-muted;
  }

  .article :global(blockquote cite::before) {
    content: "\2014\0020";
  }

  /* Responsive */
  @media (max-width: 40em) {
    .cs-container {
      @apply pt-14 px-[1.375rem] pb-14;
    }
  }

  @media (max-width: 30em) {
    .cs-container {
      @apply pt-11 px-5;
    }
  }
</style>
